<div class="section">
  <div class="page-width">
    <div class="section__heading">
      <h1>{{ 'templates.collection.all_products' | t }}</h1>
    </div>
    <ul class="product-grid">
      {%- for collection in collections -%}
        <li class="product-card">
          <a href="{{ collection.url }}" class="product-card__media" tabindex="-1" aria-hidden="true">
            {%- if collection.featured_image != blank -%}
              {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title | escape }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </a>
          <div class="product-card__info">
            <h3 class="product-card__title"><a href="{{ collection.url }}">{{ collection.title }}</a></h3>
            <p style="font-size: 1.35rem; color: var(--color-muted); margin: 0;">
              {{ 'products.facets.product_count' | t: count: collection.products_count }}
            </p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Kollektionsliste",
  "settings": []
}
{% endschema %}
