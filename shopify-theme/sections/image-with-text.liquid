<div class="section{% if section.settings.dark %} section--dark{% endif %}">
  <div class="page-width">
    <div class="image-with-text{% if section.settings.layout == 'text_first' %} image-with-text--reverse{% endif %}">
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading | escape }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div>
        {%- if section.settings.kicker != blank -%}
          <span class="hero__kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button" style="margin-top: 1.6rem;">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Billede med tekst",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Billede"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image_first", "label": "Billede først" },
        { "value": "text_first", "label": "Tekst først" }
      ],
      "default": "image_first"
    },
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Mørk baggrund",
      "default": false
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Lille overskrift",
      "default": "Hvorfor os"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Bygget til virkeligheden"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Strømafbrydelser, storme og forurenet drikkevand venter ikke på, at du bliver klar. Vores udstyr er udviklet og testet til at fungere, når alt andet svigter — enkelt nok til, at hele familien kan bruge det.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knaptekst"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knaplink"
    }
  ],
  "presets": [
    { "name": "Billede med tekst" }
  ]
}
{% endschema %}
