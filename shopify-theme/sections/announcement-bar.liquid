{%- if section.settings.text != blank -%}
  <div class="announcement-bar" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" style="color: inherit; text-decoration: none;">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Meddelelsesbjælke",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Tekst",
      "default": "Gratis fragt i hele Danmark ved køb over 399 kr. — Sendes fra dansk lager"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (valgfrit)"
    }
  ]
}
{% endschema %}
