<div class="section">
  <div class="page-width" style="max-width: 68rem;">
    <div class="section__heading">
      <h1>{{ page.title | default: section.settings.heading }}</h1>
      {%- if page.content != blank -%}
        <div class="rte">{{ page.content }}</div>
      {%- endif -%}
    </div>

    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}
        <div class="form-status form-status--success" role="status">
          {{ 'templates.contact.form.post_success' | t }}
        </div>
      {%- elsif form.errors -%}
        <div class="form-status form-status--error" role="alert">
          <strong>{{ 'templates.contact.form.error_heading' | t }}</strong>
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="field">
        <label for="ContactName">{{ 'templates.contact.form.name' | t }}</label>
        <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" autocomplete="name">
      </div>
      <div class="field">
        <label for="ContactEmail">{{ 'templates.contact.form.email' | t }} *</label>
        <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="ContactPhone">{{ 'templates.contact.form.phone' | t }}</label>
        <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
      </div>
      <div class="field">
        <label for="ContactComment">{{ 'templates.contact.form.comment' | t }} *</label>
        <textarea id="ContactComment" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </div>
      <button type="submit" class="button">{{ 'templates.contact.form.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Kontaktformular",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Kontakt os"
    }
  ],
  "presets": [
    { "name": "Kontaktformular" }
  ]
}
{% endschema %}
