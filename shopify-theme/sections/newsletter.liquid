<div class="section section--dark newsletter">
  <div class="page-width">
    <div class="section__heading">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p style="width: 100%;">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <input
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ 'newsletter.label' | t }}"
          aria-label="{{ 'newsletter.label' | t }}"
          required
        >
        <button type="submit" class="button">{{ 'newsletter.button_label' | t }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Nyhedsbrev",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Bliv klar — før det gælder"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Tilmeld dig og få beredskabstips, nye produkter og eksklusive tilbud direkte i din indbakke."
    }
  ],
  "presets": [
    { "name": "Nyhedsbrev" }
  ]
}
{% endschema %}
