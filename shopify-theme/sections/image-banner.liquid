<div class="hero">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', alt: section.settings.heading | escape }}
    </div>
  {%- endif -%}
  <div class="hero__content">
    {%- if section.settings.kicker != blank -%}
      <span class="hero__kicker">{{ section.settings.kicker }}</span>
    {%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="hero__buttons">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">{{ section.settings.button_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Baggrundsbillede"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Lille overskrift",
      "default": "Beredskabsudstyr til hele familien"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Vær klar, når det gælder"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Lab-testet nødudstyr, der beskytter dem, du holder mest af — rent drikkevand, varme og strøm, når nettet svigter."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knaptekst",
      "default": "Shop udstyret"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knaplink"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Knaptekst 2",
      "default": "Sådan virker det"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Knaplink 2"
    }
  ],
  "presets": [
    { "name": "Hero-banner" }
  ]
}
{% endschema %}
