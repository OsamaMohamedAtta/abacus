{%- comment -%}
  Renders a product card.
  Accepts: card_product (product object)
{%- endcomment -%}
<li class="product-card">
  <a href="{{ card_product.url }}" class="product-card__media" tabindex="-1" aria-hidden="true">
    {%- if card_product.featured_image != blank -%}
      {{ card_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: card_product.featured_image.alt | escape }}
    {%- endif -%}
    {%- if card_product.compare_at_price > card_product.price -%}
      <span class="product-card__badge">{{ 'products.product.on_sale' | t }}</span>
    {%- elsif card_product.available == false -%}
      <span class="product-card__badge">{{ 'products.product.sold_out' | t }}</span>
    {%- endif -%}
  </a>
  <div class="product-card__info">
    <h3 class="product-card__title">
      <a href="{{ card_product.url }}">{{ card_product.title }}</a>
    </h3>
    <div class="product-card__price">
      {% render 'price', product: card_product %}
    </div>
    <a href="{{ card_product.url }}" class="button button--secondary" style="margin-top: 1.2rem;">{{ 'products.product.view_details' | t }}</a>
  </div>
</li>
