{%- comment -%}
  Renders a product's price.
  Accepts: product (product object)
{%- endcomment -%}
{%- if product.compare_at_price > product.price -%}
  <span class="price__sale">{{ product.price | money }}</span>
  <span class="price__compare">{{ product.compare_at_price | money }}</span>
{%- elsif product.price_varies -%}
  {{ 'products.product.from_price_html' | t: price: product.price_min | money }}
{%- else -%}
  {{ product.price | money }}
{%- endif -%}
