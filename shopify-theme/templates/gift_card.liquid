{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} — Gavekort</title>
  {{ content_for_header }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <div class="section center">
    <div class="page-width" style="max-width: 56rem;">
      <h1>{{ shop.name }}</h1>
      <h2>Gavekort på {{ gift_card.initial_value | money }}</h2>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p>Dette gavekort er udløbet.</p>
      {%- else -%}
        <p>Brug koden nedenfor ved kassen:</p>
        <p style="font-size: 2.4rem; font-weight: 700; letter-spacing: 0.2em; border: 2px dashed var(--color-border); padding: 2rem; border-radius: 0.6rem;">
          {{ gift_card.code | format_code }}
        </p>
        <p>Restsaldo: {{ gift_card.balance | money }}</p>
      {%- endif -%}
      <a href="{{ shop.url }}" class="button">Begynd at handle</a>
    </div>
  </div>
</body>
</html>
